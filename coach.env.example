# Dedicated bot only. Copy values to the new service's protected variables.
# Do not source NeNoi's existing environment and do not commit filled values.
COACH_ENV=development
# A fully configured dedicated bot starts enabled, with AI and group defaults.
# Optional operator kill switches: COACH_ENABLED=0 or COACH_AI_ENABLED=0.
COACH_DISPLAY_NAME=Арни
COACH_ALIASES=арни
COACH_DATABASE_URL=
# Alternative for a separate logical DB using a protected Railway URL reference.
# Use either DATABASE_URL or the complete BASE_URL + NAME pair, never both.
COACH_DATABASE_BASE_URL=
COACH_DATABASE_NAME=
# Only the explicit bootstrap-database command uses this administrator URL.
COACH_DATABASE_BOOTSTRAP_URL=
COACH_TELEGRAM_BOT_TOKEN=
COACH_BOT_USER_ID=
COACH_BOT_USERNAME=
COACH_WEBHOOK_SECRET=
COACH_PUBLIC_BASE_URL=
# Automatically receive all supported topics in every group that adds the bot.
# Use configured for the original explicit single-group/topic allowlist mode.
COACH_GROUP_MODE=joined_groups
# In joined_groups, CHAT_ID is optional and only checks first-group access during
# setup; TOPIC_IDS is not an allowlist. Group membership drives runtime admission.
# In configured mode, both values below are required.
COACH_CHAT_ID=
COACH_TOPIC_IDS=

# Group default: archive and delivered dialogue context until author deletion.
# Individual stop/forget requests override these defaults and survive restarts.
COACH_ARCHIVE_POLICY=until_author_deletes
COACH_TRANSIENT_TTL_SECONDS=86400

# Every live call is recorded before contacting the explicitly priced model.
# observe collects statistics without a monetary cap; leave DAILY_USD empty.
# capped (the code default) requires a positive DAILY_USD.
# No model, price or technical token bound is silently inherited/defaulted.
COACH_OPENAI_API_KEY=
COACH_AI_MODEL=
COACH_AI_BUDGET_MODE=observe
COACH_AI_EMERGENCY_DAILY_USD=
COACH_AI_INPUT_USD_PER_MILLION=
COACH_AI_OUTPUT_USD_PER_MILLION=
COACH_AI_MAX_INPUT_TOKENS=
COACH_AI_MAX_OUTPUT_TOKENS=
COACH_AI_TIMEOUT_SECONDS=40
