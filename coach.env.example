# Dedicated bot only. Copy values to the new service's protected variables.
# Do not source NeNoi's existing environment and do not commit filled values.
COACH_ENV=development
# A fully configured dedicated bot starts enabled, with AI and group defaults.
# Optional operator kill switches: COACH_ENABLED=0 or COACH_AI_ENABLED=0.
COACH_DISPLAY_NAME=Арни
COACH_ALIASES=арни
COACH_DATABASE_URL=
COACH_TELEGRAM_BOT_TOKEN=
COACH_BOT_USER_ID=
COACH_BOT_USERNAME=
COACH_WEBHOOK_SECRET=
COACH_PUBLIC_BASE_URL=
COACH_CHAT_ID=
COACH_TOPIC_IDS=

# Group default: archive and delivered dialogue context until author deletion.
# Individual stop/forget requests override these defaults and survive restarts.
COACH_ARCHIVE_POLICY=until_author_deletes
COACH_TRANSIENT_TTL_SECONDS=86400

# Every live model call needs an explicitly priced model and monetary cap.
# No price, model, token limit or budget is silently inherited/defaulted.
COACH_OPENAI_API_KEY=
COACH_AI_MODEL=
COACH_AI_EMERGENCY_DAILY_USD=
COACH_AI_INPUT_USD_PER_MILLION=
COACH_AI_OUTPUT_USD_PER_MILLION=
COACH_AI_MAX_INPUT_TOKENS=
COACH_AI_MAX_OUTPUT_TOKENS=
COACH_AI_TIMEOUT_SECONDS=40
