# Optional default goal for local CLI runs.
NENOYBOT_DEFAULT_GOAL=

# Reserved for future behavior tuning. Current accepted value: firm.
NENOYBOT_STRICTNESS=firm

# Timezone for Telegram reminders.
NENOYBOT_TIMEZONE=Europe/Moscow

# How often the worker checks due reminders.
NENOYBOT_REMINDER_CHECK_INTERVAL=30

# Telegram Bot API token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Long polling timeout in seconds.
TELEGRAM_POLL_TIMEOUT=30

# OpenAI API key. If empty, the bot falls back to the local keyword engine.
OPENAI_API_KEY=

# Default model for GPT analysis.
OPENAI_MODEL=gpt-5.5

# Neon/Postgres connection string. If empty, memory is process-local only.
DATABASE_URL=

# Private Telegram care chat and comma-separated Telegram user IDs allowed to reply.
# Put real values only in the deployment secret store; never commit them.
NENOYBOT_CARE_CHAT_ID=
NENOYBOT_CARE_ADMIN_IDS=
NENOYBOT_FEEDBACK_RATE_LIMIT=5

# НеНой 2.0 runtime — never reuse v1 values in production.
NENOY_V2_ENV=development
NENOY_V2_APP_NAME=НеНой 2.0
NENOY_V2_DATABASE_URL=
NENOY_V2_TELEGRAM_BOT_TOKEN=
# Required when NENOY_V2_ENV=production.
NENOY_V2_WEBHOOK_SECRET=
# Bot identity lets the webhook normalize @mentions as DIRECT_MENTION deterministically.
NENOY_V2_TELEGRAM_BOT_USERNAME=
NENOY_V2_TELEGRAM_BOT_USER_ID=

# НеНой 2.0 OpenAI boundary. Keep real keys in the secret store only.
NENOY_V2_OPENAI_API_KEY=
NENOY_V2_MODEL_CLASSIFIER=gpt-5.6-luna
NENOY_V2_MODEL_MEMORY=gpt-5.6-luna
NENOY_V2_MODEL_GENERATOR=gpt-5.6-terra
NENOY_V2_MODEL_DEEP=gpt-5.6-sol
NENOY_V2_OPENAI_TIMEOUT_SECONDS=30

# НеНой 2.0 bounded URL reader. Reads at most one explicit public http(s) URL.
NENOY_V2_URL_READER_ENABLED=true
NENOY_V2_URL_READER_TIMEOUT_SECONDS=8
NENOY_V2_URL_READER_MAX_DOWNLOAD_BYTES=5000000
NENOY_V2_URL_READER_MAX_CONTENT_CHARS=30000
NENOY_V2_URL_READER_CACHE_TTL_SECONDS=86400
# Optional fallback for JS-heavy / blocked pages. Keep the real key in Railway secrets.
NENOY_V2_FIRECRAWL_API_KEY=
NENOY_V2_FIRECRAWL_TIMEOUT_SECONDS=20

# НеНой 2.0 worker / queue / delivery.
NENOY_V2_WORKER_IDLE_SLEEP=0.5
NENOY_V2_EVENT_PROCESSING_TIMEOUT=120
NENOY_V2_EVENT_MAX_ATTEMPTS=5
NENOY_V2_EVENT_RETRY_BASE_DELAY=5
NENOY_V2_EVENT_RETRY_MAX_DELAY=300
NENOY_V2_REMINDER_POLL_INTERVAL=5
NENOY_V2_OUTBOX_PROCESSING_TIMEOUT=120
NENOY_V2_OUTBOX_MAX_ATTEMPTS=5
NENOY_V2_OUTBOX_RETRY_BASE_DELAY=5
NENOY_V2_OUTBOX_RETRY_MAX_DELAY=300
NENOY_V2_LOG_LEVEL=INFO

# НеНой 2.0 maintenance. Runs inside the v2 worker process.
NENOY_V2_MAINTENANCE_INTERVAL_SECONDS=900
NENOY_V2_WARM_RETENTION_DAYS=30
NENOY_V2_TERMINAL_RETENTION_DAYS=30
NENOY_V2_PERSONAL_MEMORY_SOFT_CAP=150
NENOY_V2_GROUP_MEMORY_SOFT_CAP=250
